APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://pulsestream:pulsestream@localhost:5432/pulsestream
CORS_ORIGINS=http://localhost:3000
MAX_BATCH_SIZE=1000
MAX_BODY_BYTES=1048576
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_TOPIC=application-events
KAFKA_DLQ_TOPIC=dead-letter-events
KAFKA_GROUP_ID=persistence-workers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_KEY_PREFIX=pulsestream:
REDIS_IDEMPOTENCY_TTL=86400
REDIS_PER_MINUTE_TTL=120

# API-key authentication for event ingestion (comma-separated).
# EMPTY/UNSET = authentication disabled (local development).
# Example dev value used by docker-compose: ps_demo_key_local
PULSESTREAM_API_KEYS=

# ---- Server-side authentication (Increment B) ----
# Cookie-based DB-backed sessions. SESSION_COOKIE_SECURE is forced True when
# APP_ENV=production regardless of the value here.
SESSION_COOKIE_NAME=ps_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=ps_csrf
CSRF_HEADER_NAME=X-CSRF-Token
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TTL_SECONDS=1800

# ---- Google sign-in (optional OAuth provider) ----
# Leave BOTH empty to run without Google sign-in: the API then reports the
# provider as unavailable and the SPA hides the button (nothing is faked).
# Create credentials at https://console.cloud.google.com/apis/credentials and
# register the redirect URI EXACTLY as written below.
# Full setup steps: docs/google-oauth.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Origin of the SPA; the handshake only ever redirects back here.
FRONTEND_BASE_URL=http://localhost:3000
