# PulseStream dashboard — SPA + API/WS reverse proxy.
# Built from this TEMPLATE by the nginx image's envsubst entrypoint:
# DEMO_API_KEY (the local development key) is injected server-side and added
# as X-API-Key on API proxying, so the browser never contains any secret.
# Docker DNS re-resolution keeps upstream fresh across api restarts.

# Choose the credential proxied upstream:
#   - if the browser sent its OWN X-API-Key (the Traffic Lab lets a signed-in
#     user drive traffic under one of their keys), preserve it verbatim so the
#     event is attributed to that user's organization;
#   - otherwise inject DEMO_API_KEY (the shared/Demo key). An EMPTY DEMO_API_KEY
#     yields an empty value, which removes the header entirely => auth-off mode
#     works unchanged.
# Only ${DEMO_API_KEY} is substituted by envsubst; $http_x_api_key is a runtime
# nginx variable (the request's X-API-Key header) and is left intact.
map $http_x_api_key $effective_api_key {
  ""      "${DEMO_API_KEY}";
  default $http_x_api_key;
}

server {
  listen 80;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Preserve a browser-supplied key; otherwise inject DEMO_API_KEY. An empty
    # value removes the header entirely => auth-off mode works unchanged.
    proxy_set_header X-API-Key $effective_api_key;
  }

  # WebSocket endpoints. NOTE: /api/v1/ws must be matched here explicitly —
  # a bare "location /ws" does NOT cover the versioned path.
  location ~ ^/api/v1/ws$ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $ws_upstream http://api:8000;
    proxy_pass $ws_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /ws {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $ws_upstream http://api:8000;
    proxy_pass $ws_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
